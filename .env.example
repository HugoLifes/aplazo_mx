# ════════════════════════════════════════════════
#  APLAZO HONEYPOT — Variables de entorno
#  ⚠️  Este archivo NO se sube a GitHub (.gitignore)
# ════════════════════════════════════════════════

# ── WhatsApp (CallMeBot — GRATIS) ────────────────
# 1. Desde tu teléfono dedidado, manda a +34 644 597 104 por WhatsApp:
#    "I allow callmebot to send me messages"
# 2. Te responde con el API key. Ponlo aquí.
VITE_WA_PHONE=+52XXXXXXXXXX        # número con lada, ej. +525512345678
VITE_WA_APIKEY=                    # clave que te da CallMeBot

# ── SMS vía Cloudflare Worker (Twilio) ───────────
# URL del Worker que crearás en Cloudflare (ver worker/sms-worker.js)
VITE_SMS_WORKER=

# ── Telegram (opcional) ──────────────────────────
VITE_TG_TOKEN=
VITE_TG_CHAT=
